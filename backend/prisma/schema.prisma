generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String      @id @default(uuid()) @map("id")
  email        String      @unique @map("email")
  passwordHash String      @map("password_hash")
  name         String      @map("name")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  userStatus   UserStatus?

  @@map("users")
}

model UserStatus {
  id         String    @id @default(uuid()) @map("id")
  userId     String    @unique @map("user_id")
  isActive   Boolean   @default(true) @map("is_active")
  lastOnline DateTime? @map("last_online")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastOnline])
  @@map("user_statuses")
}

model PipelineStatus {
  id              String   @id @default(uuid()) @map("id")
  pipelineSuccess Boolean? @map("pipeline_success")
  pipelineMessage String?  @map("pipeline_message")
  card1           Json?    @map("card1")
  card2           Json?    @map("card2")
  card3           Json?    @map("card3")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  card4           Json?    @map("card4")
  card6           Json?    @map("card6")

  @@map("pipeline_statuses")
}

model Card1 {
  id        String   @id @default(uuid()) @map("id")
  data      Json     @map("data")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("card1")
}

model Card2 {
  id        String   @id @default(uuid()) @map("id")
  data      Json     @map("data")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("card2")
}

model Card3 {
  id        String   @id @default(uuid()) @map("id")
  data      Json     @map("data")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("card3")
}

model Card4 {
  id        String   @id @default(uuid()) @map("id")
  data      Json     @map("data")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("card4")
}

model Card6 {
  id        String   @id @default(uuid()) @map("id")
  data      Json     @map("data")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("card6")
}

model prereport {
  id        String   @id @default(uuid()) @map("id")
  data      String   @map("data")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
}

model cleanedreport {
  id        String   @id @default(uuid()) @map("id")
  data      String   @map("data")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
}

model ChatbotMessage {
  id             String   @id @default(uuid()) @map("id")
  userQuery      String   @map("user_query")
  systemResponse String   @map("system_response")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("chatbot_messages")
}

model LoadingStatus {
  id                      String   @id @default(uuid()) @map("id")
  jobId                   String   @unique @map("job_id")
  webScrapingStatus       Boolean  @default(false) @map("web_scraping_status")
  NERStatus               Boolean  @default(false) @map("ner_status")
  FilteringStatus         Boolean  @default(false) @map("filtering_status")
  MetricCalculationStatus Boolean  @default(false) @map("metric_calculation_status")
  DashboardStatus         Boolean  @default(false) @map("dashboard_status")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("loading_statuses")
}
